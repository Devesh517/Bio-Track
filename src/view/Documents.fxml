<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.DocumentController"
            styleClass="app-root">

    <top>
        <VBox styleClass="header-bar">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <Label text="Documents" styleClass="page-title"/>
            <Label text="Upload and store lab reports, prescriptions and scans" styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="16" right="24" bottom="24" left="24"/></padding>

            <VBox styleClass="panel-card upload-dropzone" spacing="10" alignment="CENTER">
                <Label text="Drag &amp; Drop your files here, or" styleClass="field-label"/>
                <Button text="Browse Files" onAction="#handleBrowseFiles" styleClass="primary-button"/>
                <Label text="Allowed: jpg, png, pdf, docx, txt (Max 5MB)" styleClass="hint-label"/>
                <Label fx:id="statusLabel" wrapText="true"/>
            </VBox>

            <VBox styleClass="panel-card" spacing="10" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Your Documents" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                    <Button text="Delete Selected" onAction="#handleDeleteSelected"/>
                </HBox>
                <ListView fx:id="documentsListView" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
