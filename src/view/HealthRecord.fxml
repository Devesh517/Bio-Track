<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.HealthRecordController"
            styleClass="app-root">

    <top>
        <VBox styleClass="header-bar">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <Label text="Health Records" styleClass="page-title"/>
            <Label text="Log and review your heart rate, blood pressure, sugar, SpO2 and weight" styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="18">
            <padding><Insets top="16" right="24" bottom="24" left="24"/></padding>

            <!-- Entry form -->
            <VBox styleClass="panel-card" spacing="10" prefWidth="320">
                <Label text="Add New Reading" styleClass="panel-title"/>

                <Label text="Date" styleClass="field-label"/>
                <DatePicker fx:id="datePicker" maxWidth="Infinity"/>

                <Label text="Heart Rate (bpm)" styleClass="field-label"/>
                <TextField fx:id="heartRateField" promptText="e.g. 72"/>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Systolic BP" styleClass="field-label"/>
                        <TextField fx:id="systolicField" promptText="120"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Diastolic BP" styleClass="field-label"/>
                        <TextField fx:id="diastolicField" promptText="80"/>
                    </VBox>
                </HBox>

                <Label text="Blood Sugar (mg/dL)" styleClass="field-label"/>
                <TextField fx:id="sugarField" promptText="e.g. 98"/>

                <Label text="SpO2 (%)" styleClass="field-label"/>
                <TextField fx:id="spo2Field" promptText="e.g. 98"/>

                <Label text="Weight (kg)" styleClass="field-label"/>
                <TextField fx:id="weightField" promptText="e.g. 62.5"/>

                <Label text="Notes" styleClass="field-label"/>
                <TextArea fx:id="notesField" prefRowCount="2" wrapText="true"/>

                <Button text="Save Record" onAction="#handleSaveRecord" styleClass="primary-button" maxWidth="Infinity"/>
                <Label fx:id="statusLabel" wrapText="true"/>
            </VBox>

            <!-- Records table -->
            <VBox styleClass="panel-card" spacing="10" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="All Records" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                    <Button text="Delete Selected" onAction="#handleDeleteSelected"/>
                </HBox>
                <TableView fx:id="recordsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="heartRateColumn" text="Heart Rate" prefWidth="90"/>
                        <TableColumn fx:id="bpColumn" text="Blood Pressure" prefWidth="120"/>
                        <TableColumn fx:id="sugarColumn" text="Sugar" prefWidth="80"/>
                        <TableColumn fx:id="spo2Column" text="SpO2" prefWidth="70"/>
                        <TableColumn fx:id="weightColumn" text="Weight" prefWidth="80"/>
                        <TableColumn fx:id="bmiColumn" text="BMI" prefWidth="70"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
