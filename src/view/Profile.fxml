<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ProfileController"
            styleClass="app-root">

    <top>
        <VBox styleClass="header-bar">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <Label text="Profile" styleClass="page-title"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="panel-card" spacing="10" maxWidth="420">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <VBox.margin><Insets top="16" right="24" bottom="24" left="24"/></VBox.margin>

            <Label fx:id="userIdLabel" styleClass="panel-title"/>

            <Label text="Full Name" styleClass="field-label"/>
            <TextField fx:id="nameField"/>

            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField"/>

            <Label text="Phone" styleClass="field-label"/>
            <TextField fx:id="phoneField"/>

            <Label text="Height (cm)" styleClass="field-label"/>
            <TextField fx:id="heightField"/>

            <Button text="Save Changes" onAction="#handleSaveProfile" styleClass="primary-button" maxWidth="Infinity"/>
            <Label fx:id="statusLabel"/>
        </VBox>
    </center>
</BorderPane>
